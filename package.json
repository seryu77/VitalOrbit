{
  "name": "vitalorbit",
  "private": true,
  "version": "0.1.0",
  "description": "Health monitoring tool for astronauts on long space missions. 2026 NASA Space Apps Challenge.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-mediapipe.mjs && vite",
    "build": "node scripts/copy-mediapipe.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "dev:server": "tsx watch server/index.ts",
    "server": "tsx server/index.ts"
  },
  "dependencies": {
    "@fastify/websocket": "^11.3.7",
    "@mediapipe/tasks-vision": "^1.2.3",
    "fastify": "^5.12.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.1",
    "gh-pages": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
